{
  "name": "@tent/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tent": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@tent/core": "workspace:*",
    "@tent/shared": "workspace:*",
    "commander": "^12.1.0",
    "@clack/prompts": "^0.7.0",
    "drizzle-orm": "^0.45.0",
    "kleur": "^4.1.5",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
