# tent control plane environment
# Copy to /etc/tent/env (root:deadplug, 0640) and fill in.
# Loaded by systemd via EnvironmentFile=.

# ─── Database ──────────────────────────────────────────────────────────────
TENT_DATABASE_URL=postgres://tent:CHANGE_ME@127.0.0.1:5432/tent

# ─── Master key for secrets-at-rest ────────────────────────────────────────
# libsodium secretbox key, base64-encoded, 32 bytes raw.
# Generate with: openssl rand -base64 32 > /etc/tent/master.key && chmod 600 /etc/tent/master.key
TENT_MASTER_KEY_FILE=/etc/tent/master.key

# ─── Discord OAuth (web UI + bot) ──────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs. These users are seeded as `admin` on first login.
DISCORD_ADMIN_USER_IDS=

# ─── Auth.js (web UI session) ──────────────────────────────────────────────
AUTH_SECRET=               # openssl rand -base64 32
AUTH_URL=https://tent.example.com

# ─── Cloudflare ────────────────────────────────────────────────────────────
# Token needs: Zone:DNS:Edit (on the zones you'll host on),
#              Account:Cloudflare Tunnel:Edit,
#              Account:Account Settings:Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ─── VPS providers — fill the ones you have, leave others blank ────────────
HETZNER_API_TOKEN=
DIGITALOCEAN_API_TOKEN=
VULTR_API_KEY=

# ─── Public host of the web UI (used in tunnel + OAuth redirect URLs) ──────
TENT_PUBLIC_HOST=tent.example.com

# ─── Runtime state directory ───────────────────────────────────────────────
# SSH keys, ansible inventory, tmp scratch — owned by deadplug.
TENT_STATE_DIR=/var/lib/tent

# ─── Job worker ────────────────────────────────────────────────────────────
TENT_WORKER_CONCURRENCY=2

# ─── Logging ───────────────────────────────────────────────────────────────
TENT_LOG_LEVEL=info
